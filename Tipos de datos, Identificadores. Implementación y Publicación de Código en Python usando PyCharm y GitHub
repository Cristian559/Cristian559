# Programa para calcular el área de un círculo
# Función que toma el radio como entrada y devuelve el área calculada

import math

def calcular_area_circulo(radio):
    """
    Esta función toma el radio de un círculo y calcula su área.
    Formula del área: área = pi * radio^2
    :param radio: El radio del círculo
    :return: El área calculada
    """
    if radio <= 0:
        return False  # Retorna False si el radio es no válido
    area = math.pi * radio ** 2
    return area

# Solicitar el radio al usuario
def obtener_radio():
    """
    Solicita al usuario un valor válido para el radio.
    :return: El radio proporcionado por el usuario como un número flotante
    """
    while True:
        try:
            radio = float(input("Por favor, ingresa el radio del círculo: "))
            if radio <= 0:
                print("El radio debe ser mayor que 0. Intenta de nuevo.")
                continue
            return radio
        except ValueError:
            print("Entrada no válida. Asegúrate de ingresar un número.")

# Función principal que ejecuta el programa
def main():
    """
    Función principal que ejecuta el flujo del programa.
    """
    radio = obtener_radio()  # Llamar a la función para obtener el radio
    area = calcular_area_circulo(radio)  # Calcular el área usando la función correspondiente
    
    if area:  # Si el área es válida
        print(f"El área del círculo con radio {radio} es {area:.2f}.")
    else:
        print("Error: Radio no válido.")
        
if __name__ == "__main__":
    main()
