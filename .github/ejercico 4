using System;
using System.Collections.Generic;

class Loteria
{
    private List<int> numerosGanadores;

    public Loteria()
    {
        numerosGanadores = new List<int>();
    }

    public void IngresarNumeros()
    {
        Console.Write("¿Cuántos números ganadores desea ingresar?: ");
        int cantidad = int.Parse(Console.ReadLine());

        for (int i = 0; i < cantidad; i++)
        {
            Console.Write($"Ingrese el número ganador #{i + 1}: ");
            int numero = int.Parse(Console.ReadLine());
            numerosGanadores.Add(numero);
        }
    }

    public void MostrarNumeros()
    {
        Console.WriteLine("\nNúmeros ganadores:");
        foreach (int numero in numerosGanadores)
        {
            Console.WriteLine($"Número ganador: {numero}");
        }
    }
}

class Program
{
    static void Main()
    {
        Loteria loteria = new Loteria();
        loteria.IngresarNumeros();
        loteria.MostrarNumeros();
    }
}
