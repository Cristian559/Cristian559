import tkinter as tk
from tkinter import messagebox
from tkinter import ttk
from tkcalendar import Calendar

# Función para agregar un evento
def agregar_evento():
    fecha = calendar.get_date()  # Obtener fecha seleccionada del DatePicker
    hora = entry_hora.get()  # Obtener hora del Entry
    descripcion = entry_descripcion.get()  # Obtener descripción del Entry
    
    if fecha and hora and descripcion:
        # Insertar evento en la lista
        tree.insert("", "end", values=(fecha, hora, descripcion))
        entry_hora.delete(0, "end")  # Limpiar campo hora
        entry_descripcion.delete(0, "end")  # Limpiar campo descripción
    else:
        messagebox.showwarning("Advertencia", "Por favor, complete todos los campos.")

# Función para eliminar un evento seleccionado
def eliminar_evento():
    seleccion = tree.selection()
    if seleccion:
        # Confirmar antes de eliminar
        respuesta = messagebox.askyesno("Confirmación", "¿Estás seguro de que deseas eliminar este evento?")
        if respuesta:
            tree.delete(seleccion)
    else:
        messagebox.showwarning("Advertencia", "Selecciona un evento para eliminar.")

# Crear la ventana principal
root = tk.Tk()
root.title("Agenda Personal")

# Crear un Frame para la lista de eventos
frame_lista = tk.Frame(root)
frame_lista.pack(pady=10)

# Crear TreeView para mostrar los eventos
tree = ttk.Treeview(frame_lista, columns=("Fecha", "Hora", "Descripción"), show="headings")
tree.heading("Fecha", text="Fecha")
tree.heading("Hora", text="Hora")
tree.heading("Descripción", text="Descripción")
tree.pack()

# Crear un Frame para la entrada de datos
frame_entrada = tk.Frame(root)
frame_entrada.pack(pady=10)

# Etiquetas y campos de entrada
label_fecha = tk.Label(frame_entrada, text="Fecha:")
label_fecha.grid(row=0, column=0, padx=10, pady=5)

calendar = Calendar(frame_entrada)
calendar.grid(row=0, column=1, padx=10, pady=5)

label_hora = tk.Label(frame_entrada, text="Hora:")
label_hora.grid(row=1, column=0, padx=10, pady=5)

entry_hora = tk.Entry(frame_entrada)
entry_hora.grid(row=1, column=1, padx=10, pady=5)

label_descripcion = tk.Label(frame_entrada, text="Descripción:")
label_descripcion.grid(row=2, column=0, padx=10, pady=5)

entry_descripcion = tk.Entry(frame_entrada)
entry_descripcion.grid(row=2, column=1, padx=10, pady=5)

# Botones
boton_agregar = tk.Button(root, text="Agregar Evento", command=agregar_evento)
boton_agregar.pack(pady=5)

boton_eliminar = tk.Button(root, text="Eliminar Evento Seleccionado", command=eliminar_evento)
boton_eliminar.pack(pady=5)

boton_salir = tk.Button(root, text="Salir", command=root.quit)
boton_salir.pack(pady=5)

# Iniciar la aplicación
root.mainloop()
