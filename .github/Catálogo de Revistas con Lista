using System;
using System.Collections.Generic;

namespace CatalogoRevistas
{
    class Program
    {
        static void Main(string[] args)
        {
            // Lista con nombres de revistas
            List<string> revistas = new List<string>
            {
                "National Geographic",
                "Time",
                "Scientific American",
                "Forbes",
                "Nature",
                "Sports Illustrated",
                "Vogue",
                "Popular Science",
                "Reader's Digest",
                "The Economist"
            };

            int opcion;
            do
            {
                Console.Clear();
                Console.WriteLine("=== CATÁLOGO DE REVISTAS ===");
                Console.WriteLine("1. Buscar revista");
                Console.WriteLine("2. Mostrar catálogo");
                Console.WriteLine("3. Salir");
                Console.Write("Seleccione una opción: ");

                if (!int.TryParse(Console.ReadLine(), out opcion))
                {
                    Console.WriteLine("\n⚠ Entrada inválida. Intente de nuevo.");
                    opcion = 0;
                }

                switch (opcion)
                {
                    case 1:
                        Console.Write("\nIngrese el nombre de la revista: ");
                        string nombre = Console.ReadLine();

                        // Buscar en la lista
                        bool encontrado = BuscarRevista(revistas, nombre);

                        if (encontrado)
                            Console.WriteLine("\n✅ Encontrado");
                        else
                            Console.WriteLine("\n❌ No encontrado");

                        Console.WriteLine("\nPresione una tecla para continuar...");
                        Console.ReadKey();
                        break;

                    case 2:
                        Console.WriteLine("\n=== LISTA DE REVISTAS ===");
                        foreach (var revista in revistas)
                        {
                            Console.WriteLine($"- {revista}");
                        }
                        Console.WriteLine("\nPresione una tecla para continuar...");
                        Console.ReadKey();
                        break;

                    case 3:
                        Console.WriteLine("\nSaliendo...");
                        break;

                    default:
                        Console.WriteLine("\n⚠ Opción no válida. Intente otra vez.");
                        Console.ReadKey();
                        break;
                }

            } while (opcion != 3);
        }

        /// <summary>
        /// Búsqueda iterativa en la lista de revistas.
        /// </summary>
        static bool BuscarRevista(List<string> lista, string nombre)
        {
            foreach (string item in lista)
            {
                if (item.Equals(nombre, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }
            return false;
        }
    }
}
