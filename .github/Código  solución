# race_with_lock.py
import threading

counter = 0
lock = threading.Lock()

def worker():
    global counter
    for _ in range(1000):
        with lock:           # sección crítica
            counter += 1

threads = [threading.Thread(target=worker) for _ in range(10)]
for t in threads:
    t.start()
for t in threads:
    t.join()

print("Esperado:", 10*1000, "Resultado:", counter)
