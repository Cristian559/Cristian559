# race_no_lock.py
import threading, time

counter = 0

def worker():
    global counter
    for _ in range(1000):
        temp = counter       # leer
        temp += 1            # modificar
        time.sleep(0)        # forzar cambio de contexto
        counter = temp       # escribir

threads = [threading.Thread(target=worker) for _ in range(10)]
for t in threads:
    t.start()
for t in threads:
    t.join()

print("Esperado:", 10*1000, "Resultado:", counter)
