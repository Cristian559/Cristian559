class Archivo:
    # Constructor: inicializa el nombre del archivo
    def __init__(self, nombre_archivo):
        print(f"Constructor: Se ha creado el objeto con el archivo '{nombre_archivo}'")
        self.nombre_archivo = nombre_archivo  # Inicializa el atributo 'nombre_archivo'
        self.archivo = None  # Inicializamos el atributo de archivo

        try:
            # Simula abrir el archivo en modo de escritura
            self.archivo = open(self.nombre_archivo, 'w')
            print(f"El archivo '{self.nombre_archivo}' ha sido abierto.")
        except Exception as e:
            print(f"Error al abrir el archivo: {e}")

    # Método para escribir en el archivo
    def escribir(self, contenido):
        if self.archivo:
            self.archivo.write(contenido + '\n')
            print(f"Escribiendo en el archivo '{self.nombre_archivo}': {contenido}")
        else:
            print("El archivo no está abierto para escritura.")

    # Destructor: se llama automáticamente cuando el objeto es destruido
    def __del__(self):
        if self.archivo:
            # Simula el cierre del archivo
            self.archivo.close()
            print(f"Destructor: El archivo '{self.nombre_archivo}' ha sido cerrado.")
        else:
            print(f"Destructor: No se pudo cerrar el archivo '{self.nombre_archivo}' porque no fue abierto correctamente.")
        

# Ejemplo de uso de la clase Archivo
if __name__ == "__main__":
    archivo1 = Archivo("ejemplo.txt")
    archivo1.escribir("Este es un ejemplo de cómo usar constructores y destructores en Python.")
    
    # Cuando el objeto 'archivo1' salga del ámbito, se llamará automáticamente al destructor
    del archivo1  # Llamada explícita al destructor, aunque en Python es automático cuando el objeto es destruido.
