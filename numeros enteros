# Programa para comparar dos listas de números enteros

# Paso 1: Ingresar la cantidad de elementos para la primera lista
n1 = int(input("Ingrese la cantidad de datos para la primera lista: "))
lista1 = []
print("Cargando datos en la primera lista:")
for i in range(n1):
    dato = int(input(f"Ingrese el dato {i+1} de la primera lista: "))
    lista1.append(dato)

# Paso 2: Ingresar la cantidad de elementos para la segunda lista
n2 = int(input("\nIngrese la cantidad de datos para la segunda lista: "))
lista2 = []
print("Cargando datos en la segunda lista:")
for i in range(n2):
    dato = int(input(f"Ingrese el dato {i+1} de la segunda lista: "))
    lista2.append(dato)

# Paso 3: Comparación de listas
print("\n--- RESULTADOS ---")
if lista1 == lista2:
    print("a. Las listas son IGUALES en tamaño y en contenido.")
elif len(lista1) == len(lista2):
    print("b. Las listas son IGUALES en tamaño, pero DIFERENTES en contenido.")
else:
    print("c. Las listas NO tienen el mismo tamaño NI el mismo contenido.")
